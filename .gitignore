__pycache__/
*.pyc
.pytest_cache/
.venv/
data/patches/*.json
data/recordings/
data/stream/
!data/.gitkeep
.DS_Store

# Move build artifacts: the exported aarch64 bundle (binaries) + build logs.
# Reproducible via move/build/build.sh; not source.
move/dist/
move/build/*.log
move/build/tone.osc
move/build/wrtone.scsyndef

# CDP cross-build output (binaries deployed to device, not tracked)
move/build/cdp-out/
move/build/cdp-build.log
move/build/espeak-out/
move/build/espeak-build.log
move/build/supernova-out/
move/build/supernova-build.log
move/build/csound-out/
move/build/csound-build.log
