# Cross-build the SuperCollider *supernova* (multithreaded) server for the Move
# (RPi CM4, AbletonOS, glibc 2.35). Ubuntu 22.04 = glibc 2.35, identical to the
# device, so the binary loads against the device's own libc.
#
# The device already runs SC 3.11.2's scsynth + its sc3-plugins *_supernova.so
# variants (from the apt packages). Debian/Ubuntu do NOT ship the supernova
# server binary, so we compile it from the MATCHING 3.11.2 source — same server-
# plugin ABI, so those _supernova.so plugins load unchanged.
#
# Built on the Mac via `docker buildx --platform linux/arm64`; the final stage is
# `scratch` so --output exports just the binary + its extra runtime libs.

FROM ubuntu:22.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake build-essential pkg-config ca-certificates patchelf \
        libjack-jackd2-dev libsndfile1-dev libfftw3-dev libasound2-dev libudev-dev \
        libboost-dev libboost-thread-dev libboost-system-dev \
        libboost-program-options-dev libboost-filesystem-dev libboost-regex-dev \
        libboost-test-dev \
    && rm -rf /var/lib/apt/lists/*

# SC 3.11.2 source WITH submodules — supernova needs its own nova-tt (threading)
# and nova-simd submodules. Several SC submodules still declare git:// URLs, which
# GitHub now refuses (connection reset) — rewrite git:// -> https:// globally first.
RUN git config --global url."https://github.com/".insteadOf "git://github.com/"
RUN git clone --depth 1 --branch Version-3.11.2 --recurse-submodules --shallow-submodules \
        https://github.com/supercollider/supercollider.git /sc

WORKDIR /sc/build
# Server-only, no IDE/Qt/sclang/Link/X11. SUPERNOVA=ON is the whole point.
# NATIVE=OFF so codegen stays generic ARMv8 (not the build host's -march).
# SYSTEM_BOOST=ON uses Ubuntu's boost (matches the device's glibc world).
RUN cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DSUPERNOVA=ON \
        -DSC_IDE=OFF -DSC_QT=OFF -DSC_ED=OFF -DSC_EL=OFF -DSC_VIM=OFF \
        -DSC_ABLETON_LINK=OFF -DSC_HIDAPI=OFF -DNO_X11=ON \
        -DSYSTEM_BOOST=OFF -DNATIVE=OFF -DINSTALL_HELP=OFF \
    && make -j"$(nproc)" supernova \
    && make -j"$(nproc)"

# ---- extra plugins' supernova variants, built against THIS SC source ----------
# supernova loads ONLY *_supernova.so. The core (SC) + sc3-plugins supernova set
# is covered above / by the device's apt build; these three sources still need
# their supernova variants: mi-UGens (Plaits/Clouds/Rings), ByteBeat, and JPverb.

# mi-UGens: its CMake ignores SUPERNOVA (raw add_library) — append a supernova
# target to each project we use, then build just those.
COPY mi-supernova.cmake /mi-supernova.cmake
RUN git clone --depth 1 --recurse-submodules --shallow-submodules \
        https://github.com/v7b1/mi-UGens.git /mi \
    && for proj in MiPlaits MiRings MiClouds; do \
         cat /mi-supernova.cmake >> /mi/projects/$proj/CMakeLists.txt; \
       done \
    && mkdir -p /mi/build && cd /mi/build \
    && cmake .. -DSC_PATH=/sc -DCMAKE_BUILD_TYPE=Release \
    && make -j"$(nproc)" MiPlaits_supernova MiRings_supernova MiClouds_supernova

# ByteBeat (midouest/bytebeat): already uses SC's sc_add_server_plugin macro, so
# -DSUPERNOVA=ON produces ByteBeat_supernova.so directly.
RUN git clone --depth 1 https://github.com/midouest/bytebeat.git /bb \
    && mkdir -p /bb/build && cd /bb/build \
    && cmake .. -DSC_PATH=/sc -DSUPERNOVA=ON -DSCSYNTH=ON -DCMAKE_BUILD_TYPE=Release \
        -DTEST=OFF -DCLI=OFF \
    && make -j"$(nproc)" ByteBeat_supernova

# sc3-plugins JPverb (the VERB effect). The full sc3 build trips over unrelated
# plugins, so build ONLY the reverb supernova targets against /sc.
# sc3-plugins has no 3.11.x tag (upstream jumped 3.9.1 -> 3.13.0); master needs a
# newer-than-3.11.2 API (ClearUnitIfMemFailed). Version-3.9.1 predates that and
# compiles against 3.11.2.
RUN git clone --depth 1 --branch Version-3.9.1 --recurse-submodules --shallow-submodules \
        https://github.com/supercollider/sc3-plugins.git /sc3 \
    && mkdir -p /sc3/build && cd /sc3/build \
    && cmake .. -DSC_PATH=/sc -DSUPERNOVA=ON -DCMAKE_BUILD_TYPE=Release -DQUARKS=OFF -DNATIVE=OFF \
    && (make -j"$(nproc)" JPverb_supernova Greyhole_supernova \
        || make JPverb_supernova || echo "JPverb build failed — check log")

# Gather the supernova server binary + the CORE UGen plugins' *_supernova.so
# variants. The device only has scsynth's core plugins (LFUGens.so etc., no
# supernova variant) plus sc3-plugins' 74 *_supernova.so — so supernova had no
# core UGens (not even Control). These fill that gap; they coexist with the
# device's scsynth .so (scsynth loads .so, supernova loads _supernova.so).
RUN set -eux; \
    SN="$(find /sc/build -type f -name supernova -perm -u+x | head -n1)"; \
    echo "built: $SN"; \
    mkdir -p /out/bin /out/lib /out/plugins; \
    cp -v "$SN" /out/bin/supernova; \
    echo "=== extra supernova products ==="; \
    find /mi/build /bb/build /sc3/build -name "*_supernova.so" | sort; \
    find /sc/build /mi/build /bb/build /sc3/build -type f -name "*_supernova.so" -exec cp -v {} /out/plugins/ \; ; \
    echo "supernova plugins gathered:"; ls /out/plugins | wc -l; \
    ldd /out/bin/supernova | awk '/=> \// {print $3}' | sort -u | tee /out/ldd.txt; \
    for so in $(ldd /out/bin/supernova | awk '/=> \// {print $3}' | sort -u); do \
        cp -vL "$so" /out/lib/ 2>/dev/null || true; \
    done; \
    ls -l /out/bin/supernova

FROM scratch AS export
COPY --from=build /out /
